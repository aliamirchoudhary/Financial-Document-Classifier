# Copy this to .env and adjust.

# Where the checkpoint lives (config.json + model.safetensors + tokenizer.json).
# Default resolves to the service/models/ dir.
# MODEL_DIR=/absolute/path/to/checkpoint

# Optional: rebuild the REAL 17-class label map from the training corpus
# (same sorted-unique order as training). If unset, uses the hardcoded fallback.
# CORPUS_JSONL=/absolute/path/to/colab.jsonl

# Set a secret string to require `Authorization: Bearer <token>` on /classes,
# /predict, /predict_text. Leave empty to disable auth (local dev only).
AUTH_TOKEN=

# Limits
MAX_NUM_PAGES=4
TOP_K=5

# Serving
HOST=0.0.0.0
PORT=8000